# Tenki workspace API key (the account that builds and publishes the image).
TENKI_API_KEY=
# Digest ref printed by `pnpm image:build`; the launcher boots this image.
BUDI_STELLAR_IMAGE=dnai/budi-stellar-dev@4c405ec1-992f-4853-8df5-e9d2f48daeb4
# Service (pnpm server): Budi's Privy app, the origins allowed to call it, and the workspace time limit.
PRIVY_APP_ID=cmv950xc802g30flc8r3ce6rm
ORIGINS=https://stellar.budi.lat,http://localhost:5173
WORKSPACE_MINUTES=45
# The learner's Budi agent: Budi's Nebius key (never sent to workspaces), this
# service's public URL (Tenki must reach /llm/v1), the model and the budget per workspace.
NEBIUS_API_KEY=
PUBLIC_URL=
AGENT_MODEL=MiniMaxAI/MiniMax-M3
AGENT_BUDGET_USD=1
